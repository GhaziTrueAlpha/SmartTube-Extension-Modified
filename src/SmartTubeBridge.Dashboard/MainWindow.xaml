<Window x:Class="SmartTubeBridge.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartTube Bridge Dashboard"
        Width="720" Height="620"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="..\..\assets\icon.ico">
    <Window.Resources>
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1E2A4A" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="SmartTube Bridge" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border x:Name="StatusBadge" Style="{StaticResource StatusBadge}" Margin="12,0,0,0">
                <TextBlock x:Name="StatusText" Text="Connecting..." FontSize="12" FontWeight="Medium" />
            </Border>
        </StackPanel>

        <!-- Status Cards Row -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="ADB STATUS" FontSize="11" Foreground="#90A4AE" />
                    <TextBlock x:Name="AdbStatusText" Text="Unknown" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="DEVICE" FontSize="11" Foreground="#90A4AE" />
                    <TextBlock x:Name="DeviceText" Text="None" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="PACKAGE" FontSize="11" Foreground="#90A4AE" />
                    <TextBlock x:Name="PackageText" Text="org.smarttube.stable" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main content area with tabs -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Dashboard" Background="Transparent" Foreground="#E0E0E0">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Device section -->
                    <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="DEVICES" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Button Content="Scan Devices" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="ScanDevices_Click" />
                            <ListBox x:Name="DeviceList" Height="200" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="ManualIpInput" Width="140" Margin="0,0,6,0" TextChanged="ManualIpInput_TextChanged" />
                                <Button x:Name="ConnectBtn" Content="Connect" IsEnabled="False" Click="ConnectManual_Click" />
                            </StackPanel>
                            <Button Content="Disconnect" Click="Disconnect_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Quick Controls -->
                    <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardBorder}" Margin="6,0,0,6">
                        <StackPanel>
                            <TextBlock Text="QUICK CONTROLS" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Play/Pause" Width="90" Margin="0,0,4,4" Click="Media_Click" Tag="playpause" />
                                <Button Content="Next" Width="70" Margin="0,0,4,4" Click="Media_Click" Tag="next" />
                                <Button Content="Prev" Width="70" Margin="0,0,4,4" Click="Media_Click" Tag="previous" />
                                <Button Content="FF" Width="55" Margin="0,0,4,4" Click="Media_Click" Tag="forward" />
                                <Button Content="RW" Width="55" Margin="0,0,4,4" Click="Media_Click" Tag="rewind" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Vol +" Width="65" Margin="0,0,4,4" Click="Media_Click" Tag="volume/up" />
                                <Button Content="Vol -" Width="65" Margin="0,0,4,4" Click="Media_Click" Tag="volume/down" />
                                <Button Content="Mute" Width="65" Margin="0,0,4,4" Click="Media_Click" Tag="volume/mute" />
                                <Button Content="Home" Width="65" Margin="0,0,4,4" Click="Media_Click" Tag="home" />
                                <Button Content="Back" Width="65" Margin="0,0,4,4" Click="Media_Click" Tag="back" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Vol" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Slider x:Name="VolumeSlider" Width="150" Minimum="0" Maximum="15" Value="8"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" />
                                <TextBlock x:Name="VolumeLabel" Text="8" Width="24" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Settings -->
                    <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardBorder}" Margin="6,6,0,0">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ADB Path" />
                                <TextBox x:Name="AdbPathInput" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Package" />
                                <TextBox x:Name="PackageInput" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="org.smarttube.stable" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Wake Delay" />
                                <ComboBox x:Name="WakeDelayInput" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                                    <ComboBoxItem Content="100ms" Tag="100" />
                                    <ComboBoxItem Content="250ms" Tag="250" />
                                    <ComboBoxItem Content="500ms" Tag="500" IsSelected="True" />
                                    <ComboBoxItem Content="1000ms" Tag="1000" />
                                    <ComboBoxItem Content="2000ms" Tag="2000" />
                                </ComboBox>

                                <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Save Settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Logs" Background="Transparent" Foreground="#E0E0E0">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="Refresh Logs" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" Click="RefreshLogs_Click" />
                    <ListBox x:Name="LogList" Grid.Row="1" Background="#111" FontFamily="Consolas" FontSize="11" />
                </Grid>
            </TabItem>

            <TabItem Header="Setup Wizard" Background="Transparent" Foreground="#E0E0E0">
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Step 1: Locate ADB" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Enter the path to adb.exe or leave as 'adb' if it's in your PATH." FontSize="12" Foreground="#90A4AE" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WizardAdbPath" Grid.Column="0" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" Content="Browse" Click="BrowseAdb_Click" Width="80" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Step 2: Scan for Devices" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Button Content="Scan Now" Width="120" Click="ScanDevices_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Step 3: Connect to TV" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Enter your TV IP address (or USB if already connected)" FontSize="12" Foreground="#90A4AE" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WizardIpInput" Grid.Column="0" Margin="0,0,6,0" TextChanged="WizardIpInput_TextChanged" />
                                    <Button x:Name="WizardConnectBtn" Grid.Column="1" Content="Connect" IsEnabled="False" Click="ConnectManual_Click" Width="100" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Step 4: Save &amp; Test" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Button Content="Test Connection" Width="150" Click="TestConnection_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StatusBar Grid.Row="3" Background="#16213E" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="FooterText" Text="Ready" FontSize="11" Foreground="#90A4AE" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
